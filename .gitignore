# Meou - GitHub repository ignore rules

# Gradle and build output
.gradle/
build/
out/
classes/

# Fabric / Minecraft development runtime
run/

# IDE project files and local editor settings
.idea/
*.iml
*.ipr
*.iws
.vscode/
bin/
.classpath
.project
.settings/
*.launch

# Java crash dumps and profiler output
hs_err_pid*.log
replay_*.log
crash-*.txt
*.hprof
*.jfr

# Python local environments and caches
.venv/
venv/
__pycache__/
*.py[cod]

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Local tools, notes, and temporary editor files
.aionrs/
.obsidian/
*.local
*.local.*
*.swp
*.swo

# Environment files and local secrets
.env
.env.*
!.env.example

# GitHub workflow and repository metadata must remain shareable
!.github/
!.github/**
